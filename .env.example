# Design Engineering Academy — environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# .env.local is git-ignored. Never commit real values.
#
# Without these the application still runs: it falls back to the local-first
# behaviour it had before cloud sync, with accounts disabled.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (formerly "anon") key.
#
# Safe to expose to the browser: every table is protected by row level
# security, so this key grants no access on its own.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER add the service-role / secret key here.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and
# served to every visitor. The service-role key bypasses row level security
# entirely; this application does not need it and must not be given it.
